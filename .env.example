# Copy to .env for local builds. .env is git-ignored; never commit real values.
# Every variable is optional. An unset value is read as "not configured" and
# the site renders its safe fallback instead of a broken or fictional claim.
#
# In CI these come from GitHub repository variables (vars.*) and secrets
# (secrets.*); see .github/workflows/deploy.yml.

# --- Analytics (repository variables) ---
# Plausible only activates when PROVIDER is exactly 'plausible' AND ID is set.
ANALYTICS_PROVIDER=
ANALYTICS_ID=

# --- SC Suspended links (repository variables) ---
SUSPENDED_DEMO_URL=
SUSPENDED_MANUAL_URL=

# --- SC Suspended checkout (repository secrets) ---
# Publish these only together with an approved public price. While they are
# empty the product CTA stays on the newsletter notification route.
STRIPE_SUSPENDED_PAYMENT_LINK_JPY=
STRIPE_SUSPENDED_PAYMENT_LINK_USD=

# --- Reserved / not currently read ---
# The live newsletter form is the hard-coded MailerLite embed in
# src/components/NewsletterForm.astro. These belong to the generic module in
# src/scripts/newsletter.ts and take effect only if that path is re-enabled.
NEWSLETTER_PROVIDER=
NEWSLETTER_FORM_ACTION=
NEWSLETTER_API_ENDPOINT=
