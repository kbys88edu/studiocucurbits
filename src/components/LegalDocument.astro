---
import { legalDocuments, type LegalSlug } from '../data/legal';
import type { Locale } from '../lib/locale';
import { localizedPath } from '../lib/locale';
import LegalDraftNotice from './LegalDraftNotice.astro';

interface Props {
  slug: LegalSlug;
  locale: Locale;
}

const { slug, locale } = Astro.props;
const document = legalDocuments[slug][locale];
const related: Array<{ slug: LegalSlug; path: string }> = (['privacy', 'terms', 'license', 'refund'] as const)
  .filter((entry) => entry !== slug)
  .map((entry) => ({ slug: entry, path: localizedPath(`/${entry}/`, locale) }));
---

<section class="page-intro" aria-labelledby="legal-title">
  <p class="eyebrow">{locale === 'ja' ? '規定' : 'LEGAL'}</p>
  <h1 id="legal-title">{document.title}</h1>
  <p class="lead">{document.intro}</p>
  <LegalDraftNotice />
</section>

{document.sections.map((section, index) => (
  <section class="section copy-block" aria-labelledby={`legal-section-${index}`}>
    <h2 id={`legal-section-${index}`}>{section.heading}</h2>
    {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
    {section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
  </section>
))}

<section class="section" aria-labelledby="legal-related-title">
  <p class="eyebrow">{locale === 'ja' ? '関連' : 'RELATED'}</p>
  <h2 id="legal-related-title">{locale === 'ja' ? 'ほかの規定' : 'Other documents'}</h2>
  <ul class="legal-links">
    {related.map((entry) => <li><a class="text-link" href={entry.path}>{legalDocuments[entry.slug][locale].title}</a></li>)}
  </ul>
</section>
