---
import type { Locale } from '../lib/locale';
import { localizedPath } from '../lib/locale';
import { getProductBySlug } from '../data/products';
import { getLaunchRelease } from '../lib/product';
import PaddleCheckout from './PaddleCheckout.astro';
const { locale } = Astro.props as { locale: Locale };
const ja = locale === 'ja';
const launch = getProductBySlug('suspended')!.launch!;
const canBuy = getLaunchRelease(launch, locale).canBuy;
---

{canBuy ? <PaddleCheckout locale={locale} /> : <section class="page-intro" aria-labelledby="purchase-title">
  <p class="eyebrow">{ja ? 'ライセンス' : 'YOUR LICENCE'}</p>
  <h1 id="purchase-title">{ja ? 'ダウンロードからライセンス認証まで' : 'From download to activation'}</h1>
  <p class="lead">{ja ? 'インストーラーは公開されており、購入前にデモを試せます。ライセンスはPaddleで購入できます。' : 'Installers are public, so you can try the demo before buying. Purchase a licence through Paddle when you are ready.'}</p>
  <p>{ja ? 'このページは支払い完了の確認ではありません。お支払い状況はPaddleの確認画面と領収書でご確認ください。' : 'This page is guidance, not payment confirmation. Check Paddle’s confirmation and receipt for your payment status.'}</p>
  <p data-payment-link-guidance hidden role="alert">{ja ? 'この決済リンクはここでは開けません。新しい購入は開始されていません。サポートへご連絡ください。' : 'This payment link cannot be opened here. No new purchase was started. Please contact support.'}</p>
  <script is:inline>
    if (new URLSearchParams(location.search).has('_ptxn')) document.querySelector('[data-payment-link-guidance]')?.removeAttribute('hidden');
  </script>
</section>}
<section class="section copy-block">
  <h2>{ja ? '1. インストールする' : '1. Install the plugin'}</h2>
  <p>{ja ? '公開済みのインストーラーはダウンロードページにあります。お使いの環境への対応をご確認ください。ダウンロードがまだ表示されない場合、その製品はまだ公開されていません。' : 'Published installers are on the downloads page. Check the supported systems before installing. If a download is not listed yet, that product has not been published.'}</p>
  <a class="button" href={localizedPath('/downloads/', locale)}>{ja ? 'ダウンロードを見る' : 'View downloads'}</a>
</section>
<section class="section copy-block">
  <h2>{ja ? '2. このタブでライセンスを設定する' : '2. Set up your licence in this tab'}</h2>
  <p>{ja ? '初回購入の決済後、このタブで認証コードを作成できます。決済の確認に少し時間がかかる場合があります。コードは1回のみ表示されるため、ページを閉じる前に保存し、他の人には渡さないでください。' : 'After your first purchase, this tab opens secure licence setup. Payment confirmation may take a moment. Generate your activation code there, save it before leaving, and do not share it.'}</p>
  <p>{ja ? '初回購入時のメールアドレスにも設定用リンクが予備として届きます。タブを閉じた場合やコードを紛失した場合は、メールのリンクまたはライセンス復旧を利用してください。' : 'A setup link also arrives at your initial checkout email as a backup. If you lose this tab or code, use the email link or licence recovery.'}</p>
</section>
<section class="section copy-block">
  <h2>{ja ? '3. プラグインを認証する' : '3. Activate the plugin'}</h2>
  <p>{ja ? 'プラグインのライセンス認証画面にコードを入力します。ライセンスはお一人につき、ご自身のコンピューター最大3台で利用できます。新しいコンピューターでも同じコードを使用し、必要に応じて以前のコンピューターを入れ替えられます。' : 'Enter the code in the plugin’s activation dialog. Your licence covers one person on up to three active computers. Use the same code on a new computer and replace an old computer when needed.'}</p>
  <p><a class="text-link" href={localizedPath('/support/', locale)}>{ja ? 'インストールとライセンスのサポート' : 'Installation and licence support'}</a></p>
  <p><a href={localizedPath('/license/', locale)}>{ja ? 'ライセンス条件' : 'Licence terms'}</a> · <a href={localizedPath('/refund/', locale)}>{ja ? '返金ポリシー' : 'Refund policy'}</a></p>
</section>
