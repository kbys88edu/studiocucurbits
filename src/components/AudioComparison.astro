---
interface Props {
  name?: string;
  drySrc?: string;
  suspendedSrc?: string;
  wetSrc?: string;
  dryLabel?: string;
  suspendedLabel?: string;
  locale?: 'en' | 'ja';
}

const { name, drySrc, suspendedSrc: configuredSuspendedSrc, wetSrc, dryLabel = 'dry', suspendedLabel = 'wet', locale = 'en' } = Astro.props;
const suspendedSrc = configuredSuspendedSrc ?? wetSrc;
const samples = [
  { id: 'dry', label: dryLabel, src: drySrc },
  { id: 'suspended', label: suspendedLabel, src: suspendedSrc },
].filter((sample): sample is { id: string; label: string; src: string } => Boolean(sample.src));
const ready = samples.length === 2;
const title = name ?? (locale === 'ja' ? '音声比較' : 'Audio comparison');
---

{ready ? (
  <section class="audio-comparison" data-audio-comparison-root data-demo-name={name} aria-label={title}>
    {name && <h3>{name}</h3>}
    <p data-audio-loading aria-live="polite">Loading audio…</p>
    {samples.map(({ id, label, src }) => (
      <div data-audio-control>
        <audio data-audio-comparison preload="metadata" controls aria-label={`${title} ${label}`}><source src={src} /></audio>
        <button type="button" data-audio-toggle data-audio-variant={id}>Play {label}</button>
      </div>
    ))}
  </section>
) : null}

<script>
  import { initAudioComparisons } from '../scripts/audio-comparison';

  initAudioComparisons();
</script>
