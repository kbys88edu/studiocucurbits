---
import type { Locale } from '../lib/locale';
import type { Product } from '../data/products';
import { localizedPath } from '../lib/locale';
import { formatPrice, getLaunchRelease } from '../lib/product';
import AudioComparison from './AudioComparison.astro';
import NewsletterForm from './NewsletterForm.astro';
import VideoSlot from './VideoSlot.astro';

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const launch = product.launch;
if (!launch) return;

const content = launch.hero[locale];
const sound = launch.sound[locale];
const concept = launch.concept[locale];
const ideas = launch.coreIdeas[locale];
const interfaceCopy = launch.interface[locale];
const difference = launch.difference[locale];
const developmentStatus = launch.developmentStatus[locale];
const notesPath = locale === 'ja' ? `/ja/products/${product.slug}/notes/` : `/products/${product.slug}/notes/`;
const announcement = launch.releaseAnnouncement[locale];
const { isReleased, canBuy, checkoutUrl, currency, introAmount, regularAmount, showIntroPrice, showRegularPrice, showNotify } = getLaunchRelease(launch, locale);
const statusLabel = isReleased
  ? (locale === 'ja' ? '販売中' : 'AVAILABLE')
  : 'PRE-RELEASE';
const releaseCta = launch.releaseCta[locale];
const supportPath = localizedPath(`/support/${product.slug}/`, locale);
const specificationsPath = localizedPath(`/products/${product.slug}/specifications/`, locale);
const audioDemos = launch.release.audioDemosEnabled ? sound.demos.filter((demo) => demo.drySrc && demo.suspendedSrc) : [];
const video = product.media.video;
const hasVideo = launch.release.videoEnabled && Boolean((video.status === 'ready' && (video.mp4 || video.webm)) || video.poster);
const hearHref = audioDemos.length ? '#sound-first' : '#concept';
const primarySpecLabels = locale === 'ja'
  ? ['種別', '形式', 'チャンネル', '主な操作', 'プリセット', '対応環境']
  : ['Type', 'Format', 'Channels', 'Operations', 'Presets', 'Environment'];
const specificationRows = launch.specifications[locale].filter(({ label }) => primarySpecLabels.includes(label));
---

<section class="suspended-launch" data-suspended-product data-release-state={launch.release.releaseState} aria-labelledby="product-title">
  <section class="suspended-hero" aria-labelledby="product-title">
    <div class="suspended-hero-copy">
      <p class="eyebrow">TRACES — {locale === 'ja' ? 'グラニュラー・オーディオ・エフェクト' : 'Granular Audio Effect'}</p>
      <p class="status-label">{statusLabel}</p>
      <h1 id="product-title">SC SUSPENDED</h1>
      {isReleased && <p class="launch-release-message">{announcement.message}</p>}
      <p class="launch-tagline">{content.tagline}</p>
      <p class="lead">{content.description}</p>
      <div class="launch-actions">
        <a class="button product-cta" data-suspended-event="click_notify_suspended" href={hearHref}>{locale === 'ja' ? 'Suspendedを聴く' : 'Hear Suspended'}</a>
        {showNotify && <a class="text-link" data-suspended-event="click_notify_suspended" href="#release-notification">{releaseCta.button}</a>}
      </div>
    </div>
    {product.media.heroImage && <img class="product-hero-image suspended-hero-image" src={product.media.heroImage} alt={interfaceCopy.imageAlt} width="1200" height="1500" loading="eager" decoding="async" />}
  </section>

  {audioDemos.length > 0 && (
    <details id="sound-first" class="launch-section launch-disclosure sound-first">
      <summary class="launch-summary"><span class="eyebrow">SOUND FIRST</span><h2 class="launch-summary-title" id="sound-first-title">{sound.title}</h2></summary>
      <div class="launch-disclosure-body">
        {audioDemos.map((demo) => <AudioComparison name={demo.name} drySrc={demo.drySrc ?? undefined} suspendedSrc={demo.suspendedSrc ?? undefined} dryLabel={demo.dryLabel} suspendedLabel={demo.suspendedLabel} locale={locale} releaseState={launch.release.releaseState} />)}
      </div>
    </details>
  )}

  {hasVideo && (
    <details class="launch-section launch-disclosure product-film">
      <summary class="launch-summary"><span class="eyebrow">PRODUCT FILM</span><h2 class="launch-summary-title" id="video-title">{launch.video[locale].title}</h2></summary>
      <div class="launch-disclosure-body">
        <VideoSlot status={video.status === 'ready' ? 'ready' : 'in-production'} poster={video.poster ?? undefined} mp4={video.mp4 ?? undefined} webm={video.webm ?? undefined} captions={video.captions ?? undefined} title={launch.video[locale].title} locale={locale} releaseState={launch.release.releaseState} />
      </div>
    </details>
  )}

  <details id="concept" class="launch-section launch-disclosure launch-concept">
    <summary class="launch-summary"><span class="eyebrow">CONCEPT</span><h2 class="launch-summary-title" id="concept-title">{concept.title}</h2></summary>
    <div class="launch-disclosure-body">
      {concept.paragraphs.map((paragraph) => <p class="lead">{paragraph}</p>)}
    </div>
  </details>

  <details class="launch-section launch-disclosure">
    <summary class="launch-summary"><span class="eyebrow">THREE CORE IDEAS</span><h2 class="launch-summary-title" id="ideas-title">{locale === 'ja' ? '三つの考え方' : 'Three core ideas'}</h2></summary>
    <div class="launch-disclosure-body">
      <div class="core-ideas">
        {ideas.map((idea) => <article class="core-idea"><h3>{idea.title}</h3><p>{idea.description}</p></article>)}
      </div>
    </div>
  </details>

  <details class="launch-section launch-disclosure interface-section">
    <summary class="launch-summary"><span class="eyebrow">INTERFACE</span><h2 class="launch-summary-title" id="interface-title">{interfaceCopy.title}</h2></summary>
    <div class="launch-disclosure-body">
      {product.media.heroImage && <img class="product-interface-image" src={product.media.heroImage} alt={interfaceCopy.imageAlt} width="1200" height="1500" loading="lazy" decoding="async" />}
      {product.media.gallery.length > 0 && (
        <div class="product-gallery-grid" aria-label={locale === 'ja' ? '追加のインターフェース画像' : 'Additional interface images'}>
          {product.media.gallery.map((image) => <img src={image} alt={locale === 'ja' ? 'SC Suspendedのインターフェース詳細' : 'SC Suspended interface detail'} width="1254" height="1254" loading="lazy" decoding="async" />)}
        </div>
      )}
      <div class="interface-controls">
        {interfaceCopy.controls.map((control) => <article><h3>{control.title}</h3><p>{control.description}</p></article>)}
      </div>
    </div>
  </details>

  <details class="launch-section launch-disclosure freeze-release-section">
    <summary class="launch-summary"><span class="eyebrow">FREEZE / RELEASE</span><h2 class="launch-summary-title" id="freeze-release-title">{locale === 'ja' ? '取り込み、手放す。' : 'Capture and let go.'}</h2></summary>
    <div class="launch-disclosure-body">
      <div class="freeze-release-grid">
        <article><h3>FREEZE</h3><p>{locale === 'ja' ? '入力された瞬間を取り込み、その内側の動きを続けたまま保持します。' : 'Capture the incoming moment and allow its internal motion to continue.'}</p></article>
        <article><h3>RELEASE</h3><p>{locale === 'ja' ? '浮遊した状態への入力を止め、残った素材を自然に減衰させます。' : 'Stop feeding the suspended state and let the remaining material decay naturally.'}</p></article>
      </div>
    </div>
  </details>

  <details class="launch-section launch-disclosure">
    <summary class="launch-summary"><span class="eyebrow">PRESETS</span><h2 class="launch-summary-title" id="presets-title">{locale === 'ja' ? '8つの出発点' : 'Eight starting points'}</h2></summary>
    <div class="launch-disclosure-body">
      <p>{locale === 'ja' ? 'ファクトリープリセットは完成した効果ではなく、出発点として設計されています。' : 'The factory presets are designed as starting conditions rather than finished effects.'}</p>
      <ol class="preset-list">{launch.presets.map((preset) => <li>{preset}</li>)}</ol>
    </div>
  </details>

  <details class="launch-section launch-disclosure">
    <summary class="launch-summary"><span class="eyebrow">USES</span><h2 class="launch-summary-title" id="uses-title">{locale === 'ja' ? 'ジャンルではなく、素材のために。' : 'Made for material, not genre.'}</h2></summary>
    <div class="launch-disclosure-body">
      <ul class="launch-list-columns">{launch.uses[locale].map((use) => <li>{use}</li>)}</ul>
    </div>
  </details>

  <details class="launch-section launch-disclosure difference-section">
    <summary class="launch-summary"><span class="eyebrow">DIFFERENCE</span><h2 class="launch-summary-title" id="difference-title">{difference.title}</h2></summary>
    <div class="launch-disclosure-body">
      {difference.paragraphs.map((paragraph) => <p class="lead">{paragraph}</p>)}
    </div>
  </details>

  <details class="launch-section launch-disclosure">
    <summary class="launch-summary"><span class="eyebrow">SPECIFICATIONS</span><h2 class="launch-summary-title" id="specifications-title">{locale === 'ja' ? '主な仕様' : 'Specifications'}</h2></summary>
    <div class="launch-disclosure-body">
      <dl class="spec-list">
        {specificationRows.map((spec) => <div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}
      </dl>
      <p class="spec-more"><a class="text-link" href={specificationsPath}>{locale === 'ja' ? '全仕様を見る' : 'View full specifications'}</a></p>
    </div>
  </details>

  <details class="launch-section launch-disclosure development-status">
    <summary class="launch-summary"><span class="eyebrow">{developmentStatus.title}</span><h2 class="launch-summary-title" id="development-title">{locale === 'ja' ? '最初の公開に向けて' : 'Preparing the first public release'}</h2></summary>
    <div class="launch-disclosure-body">
      <a class="text-link" href={notesPath}>{locale === 'ja' ? 'アーティストノートを読む' : 'Read the artist note'}</a>
    </div>
  </details>

  <details id="release-notification" class="launch-section launch-disclosure release-notification">
    <summary class="launch-summary"><span class="eyebrow">RELEASE</span><h2 class="launch-summary-title" id="release-notification-title">{canBuy ? announcement.message : releaseCta.title}</h2></summary>
    <div class="launch-disclosure-body">
      {!canBuy && <p>{releaseCta.description}</p>}
      {canBuy && (
        <>
          {(showIntroPrice || showRegularPrice) && (
            <dl class="price launch-price">
              {showIntroPrice && <div><dt>{announcement.introPriceLabel}</dt><dd>{formatPrice(introAmount!, currency, locale)}</dd></div>}
              {showRegularPrice && <div><dt>{announcement.priceLabel}</dt><dd>{formatPrice(regularAmount!, currency, locale)}</dd></div>}
            </dl>
          )}
          <p class="launch-platforms">{product.supportedFormats.join(' / ')} — {product.supportedPlatforms.join(' / ')}</p>
          <a class="button product-cta" data-suspended-event="click_suspended_buy" href={checkoutUrl}>{announcement.buy}</a>
          <p>{announcement.introNote}</p>
        </>
      )}
      {showNotify && <NewsletterForm locale={locale} source="suspended_product_page" releaseState={launch.release.releaseState} />}
      <a class="text-link" data-suspended-event="open_suspended_support" href={supportPath}>{releaseCta.support}</a>
    </div>
  </details>
</section>

<script>
  import { trackEvent } from '../lib/analytics';

  const productRoot = document.querySelector<HTMLElement>('[data-suspended-product]');
  const analyticsContext = {
    locale: document.documentElement.lang,
    source: 'suspended_product_page',
    release_state: productRoot?.dataset.releaseState ?? 'pre-release',
  };
  trackEvent('suspended_page_view', analyticsContext);
  document.querySelectorAll<HTMLElement>('[data-suspended-event]').forEach((element) => {
    element.addEventListener('click', () => {
      const events = {
        open_suspended_support: 'suspended_support_click',
        click_suspended_buy: 'suspended_buy_click',
      } as const;
      const key = element.dataset.suspendedEvent as keyof typeof events;
      trackEvent(events[key] ?? 'suspended_notify_click', analyticsContext);
    });
  });

  function openTargetedPanel() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const panel = document.getElementById(id)?.closest('details');
    if (!panel) return;
    panel.open = true;
    panel.scrollIntoView({ block: 'start' });
  }

  window.addEventListener('hashchange', openTargetedPanel);
  openTargetedPanel();
</script>
