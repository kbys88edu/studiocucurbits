---
import type { Locale } from '../lib/locale';
import type { Product } from '../data/products';
import { suspendedCheckout } from '../data/products';
import { suspendedShopOffers, suspendedShopProduct, shopPreview } from '../data/shopCatalogue';
import { localizedPath } from '../lib/locale';

interface Props { product: Product; locale: Locale; }
const { product, locale } = Astro.props;
const shopProduct = suspendedShopProduct;
if (!shopProduct) return;

const ja = locale === 'ja';
const hero = product.launch!.hero[locale];
const description = shopProduct.description[locale] || shopProduct.description.en;
const descriptionBlocks = description.split(/\n\s*\n/).map((block) => ({
  heading: block.startsWith('## '), text: block.replace(/^## /, '').trim(),
}));
const downloadPage = localizedPath(shopProduct.downloadPageUrl, locale);
const purchasePage = localizedPath(`/purchase/${product.slug}/`, locale);
const supportPage = localizedPath(`/support/${product.slug}/`, locale);
let staging: Array<{ name: string; url: string; version?: string }> = [];
if (import.meta.env.MODE === 'development') {
  try {
    const value = JSON.parse(import.meta.env.SUSPENDED_STAGING_INSTALLERS ?? '[]');
    if (Array.isArray(value)) staging = value.filter((item) => item &&
      typeof item.name === 'string' && /suspended.*\.(pkg|deb|tar\.zst|exe|msi)$/i.test(item.name) &&
      typeof item.url === 'string' && item.url.startsWith('https://'));
  } catch {}
}
const installers = staging.length ? staging.map(({ name, url }) => ({ name, url,
  platform: name.endsWith('.pkg') ? 'macos' : /\.(exe|msi)$/i.test(name) ? 'windows' : 'linux',
})) : (shopProduct.release?.installers ?? []).map(({ url, os, format }) => ({
  name: format, url, platform: /^mac/i.test(os) ? 'macos' : /^win/i.test(os) ? 'windows' : 'linux',
}));
---

<section class="suspended-launch" data-suspended-product data-installers={JSON.stringify(installers)} aria-labelledby="product-title">
  <div class="suspended-hero">
    <div class="suspended-hero-copy">
      <p class="eyebrow">TRACES — {ja ? 'グラニュラー・オーディオ・エフェクト' : 'Granular Audio Effect'}</p>
      {shopPreview && <p class="status-label" role="note">{ja ? 'プライベート・プレビュー · テスト購入のみ' : 'PRIVATE PREVIEW · TEST PURCHASES ONLY'}</p>}
      <h1 id="product-title">SC SUSPENDED</h1>
      <p class="launch-tagline">{hero.tagline}</p>
      <p class="lead">{hero.description}</p>

      <div class="shop-offers" aria-label={ja ? '購入オプション' : 'Purchase options'}>
        <table>
          <tbody>{suspendedShopOffers.map((offer) => <tr>
            <th scope="row">{offer.name[locale]}</th>
            <td>{new Intl.NumberFormat(ja ? 'ja-JP' : 'en-US', { style: 'currency', currency: offer.price.currency, maximumFractionDigits: 0 }).format(offer.price.amountMinor / 100)}</td>
            <td>{suspendedCheckout.url && offer.paddlePriceId === suspendedCheckout.priceId
              ? <a class="button shop-buy" href={purchasePage}>BUY</a>
              : <span class="button shop-buy shop-buy-disabled" aria-disabled="true">BUY</span>}</td>
          </tr>)}</tbody>
        </table>
      </div>

      <div class="shop-download">
        <a class="download-primary" data-recommended-download href={downloadPage}><span class="shop-download-label"><img data-download-icon alt="" hidden /><span data-download-text>{ja ? 'インストーラーを選ぶ' : 'Choose an installer'}</span></span></a>
        <a class="shop-download-all" href={downloadPage}>{ja ? 'すべてのインストーラーとバージョンを見る' : 'All installers and versions'} →</a>
      </div>
    </div>
    {shopProduct.media.hero && <img class="product-hero-image suspended-hero-image" src={shopProduct.media.hero} alt={ja ? 'SC Suspendedのパッケージ画像' : 'SC Suspended package artwork'} width="1200" height="1500" loading="eager" decoding="async" />}
  </div>

  <section class="launch-section shop-description" aria-label={ja ? '製品について' : 'About Suspended'}>
    <p class="eyebrow">{ja ? '製品について' : 'ABOUT SUSPENDED'}</p>
    {descriptionBlocks.map((block) => block.heading ? <h2>{block.text}</h2> : <p>{block.text}</p>)}
  </section>
  <p class="shop-support"><a href={supportPage}>{ja ? 'セットアップとサポート' : 'Setup and support'} →</a></p>
</section>

<script>
  import { detectPlatform } from '../lib/downloads';
  const root = document.querySelector<HTMLElement>('[data-suspended-product]');
  const action = root?.querySelector<HTMLAnchorElement>('[data-recommended-download]');
  const icon = action?.querySelector<HTMLImageElement>('[data-download-icon]');
  const label = action?.querySelector<HTMLElement>('[data-download-text]');
  if (root && action && icon && label) {
    const installers = JSON.parse(root.dataset.installers ?? '[]') as Array<{ name: string; url: string; platform: string }>;
    const platform = detectPlatform(navigator.userAgent);
    const matching = installers.filter((item) => item.platform === platform);
    const recommended = matching.find((item) => platform !== 'linux' || item.name.endsWith('.deb')) ?? matching[0];
    if (recommended) {
      action.href = recommended.url;
      icon.src = `/images/platforms/${platform}.svg`;
      icon.hidden = false;
      label.textContent = document.documentElement.lang === 'ja'
        ? `${platform === 'macos' ? 'macOS' : platform === 'windows' ? 'Windows' : 'Linux'}版をダウンロード`
        : `Download for ${platform === 'macos' ? 'macOS' : platform === 'windows' ? 'Windows' : 'Linux'}`;
    }
  }
</script>
