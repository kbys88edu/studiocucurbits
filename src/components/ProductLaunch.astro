---
import type { Locale } from '../lib/locale';
import type { Product } from '../data/products';
import { localizedPath } from '../lib/locale';
import AudioComparison from './AudioComparison.astro';
import NewsletterForm from './NewsletterForm.astro';
import VideoSlot from './VideoSlot.astro';

interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const launch = product.launch;
if (!launch) return;

const content = launch.hero[locale];
const sound = launch.sound[locale];
const concept = launch.concept[locale];
const ideas = launch.coreIdeas[locale];
const interfaceCopy = launch.interface[locale];
const difference = launch.difference[locale];
const developmentStatus = launch.developmentStatus[locale];
const releaseCta = launch.releaseCta[locale];
const supportPath = localizedPath(`/support/${product.slug}/`, locale);
const audioDemos = launch.release.audioDemosEnabled ? sound.demos.filter((demo) => demo.drySrc && demo.suspendedSrc) : [];
const video = product.media.video;
const hasVideo = launch.release.videoEnabled && Boolean((video.status === 'ready' && (video.mp4 || video.webm)) || video.poster);
const hearHref = audioDemos.length ? '#sound-first' : '#concept';
const specificationRows = launch.specifications[locale].filter(({ label }) => !['Product', '製品名', 'Status', 'ステータス'].includes(label));
---

<section class="suspended-launch" data-suspended-product data-release-state={launch.release.releaseState} aria-labelledby="product-title">
  <section class="suspended-hero" aria-labelledby="product-title">
    <div class="suspended-hero-copy">
      <p class="eyebrow">TRACES — {locale === 'ja' ? 'グラニュラー・オーディオ・エフェクト' : 'Granular Audio Effect'}</p>
      <p class="status-label">PRE-RELEASE</p>
      <h1 id="product-title">SC SUSPENDED</h1>
      <p class="launch-tagline">{content.tagline}</p>
      <p class="lead">{content.description}</p>
      <div class="launch-actions">
        <a class="button product-cta" data-suspended-event="click_notify_suspended" href={hearHref}>{locale === 'ja' ? 'Suspendedを聴く' : 'Hear Suspended'}</a>
        {launch.release.showNewsletterCTA && <a class="text-link" data-suspended-event="click_notify_suspended" href="#release-notification">{releaseCta.button}</a>}
      </div>
    </div>
    {product.media.heroImage && <img class="product-hero-image suspended-hero-image" src={product.media.heroImage} alt={interfaceCopy.imageAlt} width="1200" height="1500" loading="eager" decoding="async" />}
  </section>

  <section id="sound-first" class="launch-section sound-first" aria-labelledby="sound-first-title">
    <p class="eyebrow">SOUND FIRST</p>
    <h2 id="sound-first-title">{sound.title}</h2>
    {audioDemos.map((demo) => <AudioComparison name={demo.name} drySrc={demo.drySrc ?? undefined} suspendedSrc={demo.suspendedSrc ?? undefined} dryLabel={demo.dryLabel} suspendedLabel={demo.suspendedLabel} locale={locale} releaseState={launch.release.releaseState} />)}
  </section>

  {hasVideo && (
    <section class="launch-section product-film" aria-labelledby="video-title">
      <p class="eyebrow">PRODUCT FILM</p>
      <h2 id="video-title">{launch.video[locale].title}</h2>
      <VideoSlot status={video.status === 'ready' ? 'ready' : 'in-production'} poster={video.poster ?? undefined} mp4={video.mp4 ?? undefined} webm={video.webm ?? undefined} captions={video.captions ?? undefined} title={launch.video[locale].title} locale={locale} releaseState={launch.release.releaseState} />
    </section>
  )}

  <section id="concept" class="launch-section launch-concept" aria-labelledby="concept-title">
    <p class="eyebrow">CONCEPT</p>
    <h2 id="concept-title">{concept.title}</h2>
    {concept.paragraphs.map((paragraph) => <p class="lead">{paragraph}</p>)}
  </section>

  <section class="launch-section" aria-labelledby="ideas-title">
    <p class="eyebrow">THREE CORE IDEAS</p>
    <h2 id="ideas-title">{locale === 'ja' ? '三つの考え方' : 'Three core ideas'}</h2>
    <div class="core-ideas">
      {ideas.map((idea) => <article class="core-idea"><h3>{idea.title}</h3><p>{idea.description}</p></article>)}
    </div>
  </section>

  <section class="launch-section interface-section" aria-labelledby="interface-title">
    <p class="eyebrow">INTERFACE</p>
    <h2 id="interface-title">{interfaceCopy.title}</h2>
    {product.media.heroImage && <img class="product-interface-image" src={product.media.heroImage} alt={interfaceCopy.imageAlt} width="1200" height="1500" loading="lazy" decoding="async" />}
    <div class="interface-controls">
      {interfaceCopy.controls.map((control) => <article><h3>{control.title}</h3><p>{control.description}</p></article>)}
    </div>
  </section>

  <section class="launch-section freeze-release-section" aria-labelledby="freeze-release-title">
    <p class="eyebrow">FREEZE / RELEASE</p>
    <h2 id="freeze-release-title">{locale === 'ja' ? '取り込み、手放す。' : 'Capture and let go.'}</h2>
    <div class="freeze-release-grid">
      <article><h3>FREEZE</h3><p>{locale === 'ja' ? '入力された瞬間を取り込み、その内側の動きを続けたまま保持します。' : 'Capture the incoming moment and allow its internal motion to continue.'}</p></article>
      <article><h3>RELEASE</h3><p>{locale === 'ja' ? '浮遊した状態への入力を止め、残った素材を自然に減衰させます。' : 'Stop feeding the suspended state and let the remaining material decay naturally.'}</p></article>
    </div>
  </section>

  <section class="launch-section" aria-labelledby="presets-title">
    <p class="eyebrow">PRESETS</p>
    <h2 id="presets-title">Eight starting points</h2>
    <p>{locale === 'ja' ? 'ファクトリープリセットは完成した効果ではなく、出発点として設計されています。' : 'The factory presets are designed as starting conditions rather than finished effects.'}</p>
    <ol class="preset-list">{launch.presets.map((preset) => <li>{preset}</li>)}</ol>
  </section>

  <section class="launch-section" aria-labelledby="uses-title">
    <p class="eyebrow">USES</p>
    <h2 id="uses-title">{locale === 'ja' ? 'ジャンルではなく、素材のために。' : 'Made for material, not genre.'}</h2>
    <ul class="launch-list-columns">{launch.uses[locale].map((use) => <li>{use}</li>)}</ul>
  </section>

  <section class="launch-section difference-section" aria-labelledby="difference-title">
    <p class="eyebrow">DIFFERENCE</p>
    <h2 id="difference-title">{difference.title}</h2>
    {difference.paragraphs.map((paragraph) => <p class="lead">{paragraph}</p>)}
  </section>

  <section class="launch-section" aria-labelledby="specifications-title">
    <p class="eyebrow">FACTORY SPECIFICATIONS</p>
    <h2 id="specifications-title">{locale === 'ja' ? 'ファクトリー仕様' : 'Factory specifications'}</h2>
    <dl class="spec-list">
      {specificationRows.map((spec) => <div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}
    </dl>
  </section>

  <section class="launch-section development-status" aria-labelledby="development-title">
    <p class="eyebrow">{developmentStatus.title}</p>
    <h2 id="development-title">{locale === 'ja' ? '最初の公開に向けて' : 'Preparing the first public release'}</h2>
    {developmentStatus.paragraphs.map((paragraph) => <p class="lead">{paragraph}</p>)}
  </section>

  <section id="release-notification" class="launch-section release-notification" aria-labelledby="release-notification-title">
    <p class="eyebrow">RELEASE</p>
    <h2 id="release-notification-title">{releaseCta.title}</h2>
    <p>{releaseCta.description}</p>
    {launch.release.showNewsletterCTA && <NewsletterForm locale={locale} source="suspended_product_page" releaseState={launch.release.releaseState} />}
    <a class="text-link" data-suspended-event="open_suspended_support" href={supportPath}>{releaseCta.support}</a>
  </section>
</section>

<script>
  import { trackEvent } from '../lib/analytics';

  const productRoot = document.querySelector<HTMLElement>('[data-suspended-product]');
  const analyticsContext = {
    locale: document.documentElement.lang,
    source: 'suspended_product_page',
    release_state: productRoot?.dataset.releaseState ?? 'pre-release',
  };
  trackEvent('suspended_page_view', analyticsContext);
  document.querySelectorAll<HTMLElement>('[data-suspended-event]').forEach((element) => {
    element.addEventListener('click', () => {
      const event = element.dataset.suspendedEvent === 'open_suspended_support' ? 'suspended_support_click' : 'suspended_notify_click';
      trackEvent(event, analyticsContext);
    });
  });
</script>
