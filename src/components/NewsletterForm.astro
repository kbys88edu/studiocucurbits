---
import type { Locale } from '../lib/locale';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const formCopy = locale === 'ja' ? { email: 'メールアドレス', subscribe: '登録する' } : { email: 'Email', subscribe: 'Subscribe' };
---

<div id="mlb2-44184182" class="ml-form-embedContainer ml-subscribe-form ml-subscribe-form-44184182">
  <div class="ml-form-align-left">
    <div class="ml-form-embedWrapper embedForm">
      <div class="ml-form-embedBody ml-form-embedBodyDefault row-form">
        <form class="ml-block-form newsletter-form" action="https://assets.mailerlite.com/jsonp/2536948/forms/194159585016153657/subscribe" method="post" target="_blank">
          <label for="newsletter-email">{formCopy.email}</label>
          <input id="newsletter-email" name="fields[email]" type="email" autocomplete="email" required placeholder={formCopy.email} />
          <input type="hidden" name="ml-submit" value="1" />
          <input type="hidden" name="anticsrf" value="true" />
          <button type="submit">{formCopy.subscribe}</button>
        </form>
      </div>
      <div class="ml-form-successBody row-success" hidden>
        <p>{locale === 'ja' ? '登録ありがとうございます。確認メールをご確認ください。' : 'Thank you. Please check your email to confirm your subscription.'}</p>
      </div>
    </div>
  </div>
</div>
<script src="https://groot.mailerlite.com/js/w/webforms.min.js?v83147fa8ce2d95cb73ece7f28b469519" is:inline></script>
<script is:inline>fetch("https://assets.mailerlite.com/jsonp/2536948/forms/194159585016153657/takel");</script>
