---
import ProductNotes from '../../../../components/ProductNotes.astro';
import { getProductBySlug, isVisibleProduct, products } from '../../../../data/products';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return products
    .filter((product) => isVisibleProduct(product) && product.launch)
    .map((product) => ({ params: { slug: product.slug } }));
}

const product = getProductBySlug(Astro.params.slug ?? '');
if (!product || product.status === 'hidden' || !product.launch) return Astro.redirect('/ja/products/');
---

<BaseLayout
  title={`${product.name} アーティストノート | オーディオ・インストゥルメンツ | Studio Cucurbits.`}
  description={`${product.name}の開発の経過と現在地。`}
  canonicalPath={`/ja/products/${product.slug}/notes/`}
  locale="ja"
  product={product}
  breadcrumbLabel={`${product.name} アーティストノート`}
>
  <ProductNotes product={product} locale="ja" />
</BaseLayout>
