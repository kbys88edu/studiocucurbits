---
import NewsletterForm from '../../components/NewsletterForm.astro';
import ReleaseAvailability from '../../components/ReleaseAvailability.astro';
import { MOCKUP_V } from '../../data/site';
import { getLocale, localizedPath } from '../../lib/locale';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { suspendedShopVisible } from '../../data/shopCatalogue';

const locale = getLocale(new URL(Astro.request.url));
const canonicalPath = locale === 'ja' ? '/ja/products/' : '/products/';
const copy = locale === 'ja'
  ? { title: 'オーディオ・インストゥルメンツ | Studio Cucurbits.', description: 'Studio Cucurbits.のオーディオ・インストゥルメンツは、作曲家が設計した楽器とエフェクトです。', eyebrow: 'Studio Cucurbits / オーディオ・インストゥルメンツ', heading: 'オーディオ・インストゥルメンツ', lead: '作曲家が設計した楽器とエフェクト。', development: '公開状況', details: '製品、デモ、ベータ版は準備が整い次第お知らせします。', mailing: '今後の情報を受け取る' }
  : { title: 'PRODUCTS | Studio Cucurbits.', description: 'Artist-designed instruments and effects from Studio Cucurbits.', eyebrow: 'Studio Cucurbits / Products', heading: 'PRODUCTS', lead: 'Artist-designed instruments and effects.', development: 'Release status', details: 'Products, demonstrations, and beta access will be announced when they are ready.', mailing: 'Receive future announcements' };
const statusRows = [
  { name: 'Suspended', slug: 'suspended', href: suspendedShopVisible ? localizedPath('/products/suspended/', locale) : null },
  { name: 'Traces bundle', slug: 'traces', href: null },
  { name: 'Tendril bundle', slug: 'tendril', href: null },
  { name: 'Vitreous', slug: 'vitreous', href: null },
];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonicalPath={canonicalPath}
  locale={locale}
>
  <section class="page-intro" aria-labelledby="products-title">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 id="products-title">{copy.heading}</h1>
    <p class="lead">{copy.lead}</p>
  </section>

  <section class="section" aria-labelledby="development-title">
    <figure class="product-overview-hero">
      <img src={`/images/products/Hero_2560x1440.png${MOCKUP_V}`} width="2560" height="1440" alt="" loading="eager" decoding="async" />
    </figure>
    <p class="eyebrow">{copy.development}</p>
    <h2 id="development-title">{copy.development}</h2>
    <p class="lead">{copy.details}</p>
    <div class="catalogue-status" aria-label={copy.development}>
      {statusRows.map((row) => <div class="catalogue-status-row"><h3>{row.href ? <a href={row.href}>{row.name}</a> : row.name}</h3><p><ReleaseAvailability slug={row.slug} name={row.name} locale={locale} variant="status" /></p></div>)}
    </div>
    <div class="product-overview-newsletter">
      <p class="eyebrow">{copy.mailing}</p>
      <NewsletterForm locale={locale} />
    </div>
  </section>
</BaseLayout>
