---
import LegalDocument from '../components/LegalDocument.astro';
import { legalDocuments } from '../data/legal';
import BaseLayout from '../layouts/BaseLayout.astro';

const document = legalDocuments.terms.en;
---

<BaseLayout title={`${document.title} | Studio Cucurbits.`} description={document.description} canonicalPath="/terms/">
  <LegalDocument slug="terms" locale="en" />
</BaseLayout>
