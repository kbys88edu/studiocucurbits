---
import LegalDocument from '../components/LegalDocument.astro';
import { legalDocuments } from '../data/legal';
import BaseLayout from '../layouts/BaseLayout.astro';

const document = legalDocuments.license.en;
---

<BaseLayout title={`${document.title} | Studio Cucurbits.`} description={document.description} canonicalPath="/license/">
  <LegalDocument slug="license" locale="en" />
</BaseLayout>
