{
  "name": "studio-cucurbits",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-catalogue-media.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-catalogue-media.mjs",
    "build": "astro build",
    "prebuild:sandbox": "node scripts/sync-catalogue-media.mjs",
    "build:sandbox": "astro build --mode sandbox --outDir dist-sandbox",
    "preview": "astro preview",
    "preview:sandbox": "astro preview --outDir dist-sandbox",
    "check": "astro check",
    "test": "vitest run --no-file-parallelism",
    "test:browser": "playwright test",
    "test:licensing": "playwright test --config playwright.licensing.config.ts",
    "test:checkout": "playwright test --config playwright.checkout.config.ts",
    "verify": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "astro": "^7.2.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0"
  }
}
